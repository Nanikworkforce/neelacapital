# Copy to .env and fill in real values. Never commit real passwords.

# Required
SECRET_KEY=generate-a-long-random-string
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DBNAME

# URLs
SITE_URL=https://neelacapital.com
FRONTEND_URL=https://neelacapital.com/portal
ALLOWED_HOSTS=neela-backend-dfmg.onrender.com,neelacapital.com,www.neelacapital.com
CORS_ALLOWED_ORIGINS=https://neelacapital.com,https://www.neelacapital.com
DEBUG=False

# Email — prefer Gmail API on Render free (HTTPS). Run: python manage.py gmail_oauth_setup
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
DEFAULT_FROM_EMAIL=Neela Capital <info@neelacapital.com>

# Fallback: Google Workspace SMTP (works locally / paid Render only)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=info@neelacapital.com
# EMAIL_HOST_PASSWORD=your-google-app-password

# Contacts
LANDLORD_EMAIL=info@neelacapital.com
ADMIN_EMAIL=info@neelacapital.com
LANDLORD_NAME=Neela Capital

# Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Celery/Redis optional (emails use background threads by default)
USE_CELERY=false
